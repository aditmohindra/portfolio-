---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import TagList from '../../components/ui/TagList.astro';
import FlareHeroWindow from '../../components/projects/FlareHeroWindow.astro';
import TechArchitectureSection from '../../components/projects/TechArchitectureSection.astro';
import { getEntry } from 'astro:content';

const project = await getEntry('projects', 'coreai-market-flare');
if (!project) {
  throw new Error('Project entry "coreai-market-flare" not found');
}

const { heroImage, summary: projectSummary } = project.data;
const detailLogo = heroImage;

const techStack = [
  'Python',
  'XGBoost',
  'Random Forest',
  'LightGBM',
  'SARIMA',
  'K-Means',
  'SQL',
  'Streamlit',
];

const builtItems = [
  'Engineered 50+ features from raw transaction data (101,462 rows) at the ZIP-code × month level, including momentum, volatility, Fourier/cyclic transforms, and lag features',
  'Built a K-Means clustering approach (K=12, tuned via MAE) to group behaviorally similar ZIP codes, capturing subtle market patterns lost in broader city/county aggregations',
  'Trained independent Random Forest and XGBoost models per cluster to forecast three key market indicators 1-6 months ahead: Days on Market, Absorption Rate, and Offer-to-List Price Ratio',
  'Designed a weighted aggregation layer that combines the three forecasted indicators into a single composite Hotness Score, with user-adjustable weights (custom vs. equal) to let domain experts prioritize specific market dynamics',
  'Handled erratic ZIP clusters (highly volatile behavior, sharp market shifts, sparse data) by modeling outliers separately and manually adjusting cluster assignments',
];

const keyFeatures = [
  {
    label:
      'Modular forecasting architecture: independently predicts each market indicator rather than a black-box hotness score, tracing exactly how each factor contributes',
    d: 'M4 4h11v11H4z M9 9h11v11H9z',
  },
  {
    label:
      'Cluster-aware modeling: ZIP codes grouped by K-Means (K=12) into behaviorally similar segments, with lag-based temporal panels capturing time-based patterns',
    d: 'M6 7a1.3 1.3 0 1 1 0-2.6A1.3 1.3 0 0 1 6 7z M11 5.4a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z M14.5 10.5a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z M8.5 13a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z',
  },
  {
    label:
      'Ensemble forecasting: Random Forest + XGBoost per cluster per indicator, validated with MAE, RMSE, R², and SMAPE',
    d: 'M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z',
  },
  {
    label:
      'Customizable weighted scoring: users can set custom or equal weights across indicators to tailor the composite Hotness Score to their needs',
    d: 'M10 8l6 4-6 4V8z',
  },
  {
    label:
      'Interactive Streamlit dashboard: choropleth map visualization of ZIP-level hotness across California with city/county/postal code search',
    d: 'M13 2L4 14h6l-1 8 9-12h-6l1-8z',
  },
  {
    label:
      'Team capstone: built with 3 teammates and industry/UCI mentors; 1st Place, 2025 UCI ICS Project Expo',
    d: 'M4 12l5 5L20 6',
  },
];

const summary = projectSummary;
---

<BaseLayout title="CoreAI Market Flare · Adit Mohindra" description={summary}>
  <Container>
    <article class="atlas-page">
      <p class="atlas-page__breadcrumb">
        <span class="atlas-page__breadcrumb-dot" aria-hidden="true"></span>
        <a href="/projects">Projects</a>
        <span aria-hidden="true">/</span>
        <span>CoreAI Market Flare</span>
      </p>

      <header class="atlas-page__header">
        <div class="atlas-page__intro">
          {
            detailLogo ? (
              <img
                src={detailLogo}
                alt="University of California, Irvine"
                class="atlas-page__project-logo"
                width="768"
                height="416"
                loading="eager"
              />
            ) : null
          }

          <h1 class="atlas-page__title">
            <span class="font-display">CoreAI</span><span class="font-display"> Market Flare</span>
          </h1>

          <p class="atlas-page__summary">{summary}</p>

          <div class="atlas-page__badges">
            <Badge>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                aria-hidden="true"
              >
                <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                <path d="M12 3v9M4 7.5l8 4.5 8-4.5" opacity="0.5"></path>
              </svg>
              Capstone Project
            </Badge>
            <Badge>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                aria-hidden="true"
              >
                <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                <path d="M12 3v9M4 7.5l8 4.5 8-4.5" opacity="0.5"></path>
              </svg>
              ML / Data Product
            </Badge>
          </div>

          <div class="atlas-page__stack">
            <p class="atlas-page__stack-label">Tech Stack</p>
            <TagList tags={techStack} />
          </div>

          <div class="atlas-page__actions">
            <Button
              variant="primary"
              href="https://github.com/aditmohindra/Real-Estate-AI-Market-Flare"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                aria-hidden="true"
              >
                <path
                  d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.6-.3 5.3-1.3 5.3-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.7 2.7 5.7 5.3 6-.6.6-.6 1.2-.5 2V21"
                ></path>
              </svg>
              View Code
            </Button>
          </div>
        </div>

        <div class="atlas-page__graphic">
          <FlareHeroWindow />
        </div>
      </header>

      <section class="atlas-page__info-grid" aria-label="Project details">
        <div class="atlas-info-card">
          <h2 class="atlas-info-card__title">Overview</h2>
          <p class="atlas-info-card__text">
            CoreAI Market Flare forecasts real estate market "hotness" at the ZIP-code level across
            California. Built during my UCI Data Science capstone in partnership with a leading
            real estate data provider, the system won 1st Place at the 2025 UCI ICS Project Expo.
          </p>
          <h3 class="atlas-info-card__subtitle">The Problem</h3>
          <p class="atlas-info-card__text">
            Real estate hotness — where demand exceeds supply and homes sell over list price — is
            difficult to quantify directly. A single "hotness score" hides which underlying market
            forces are driving it and makes the score hard to trust or explain.
          </p>
          <p class="atlas-info-card__text atlas-info-card__text--spaced">
            Our approach: instead of predicting hotness directly, we independently forecast the
            underlying market indicators (Days on Market, Absorption Rate, Offer-to-List Price
            Ratio) using ZIP-level historical data, then combine those predictions into a single,
            weighted, explainable Hotness Score.
          </p>
        </div>

        <div class="atlas-info-card">
          <h2 class="atlas-info-card__title">What I Built</h2>
          <ul class="atlas-checklist">
            {
              builtItems.map((item) => (
                <li class="atlas-checklist__item">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                    aria-hidden="true"
                    class="atlas-checklist__icon"
                  >
                    <path d="M4 12l5 5L20 6" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="atlas-info-card">
          <h2 class="atlas-info-card__title">Key Features</h2>
          <ul class="atlas-features">
            {
              keyFeatures.map((feature) => (
                <li class="atlas-features__item">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                    aria-hidden="true"
                    class="atlas-features__icon"
                  >
                    <path d={feature.d} />
                  </svg>
                  <span>{feature.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <TechArchitectureSection
        sectionId="flare-technical-architecture"
        imageSrc="/images/projects/coreai-market-flare-architecture.png"
        imageAlt="CoreAI Market Flare technical architecture diagram showing data sources, preprocessing and feature engineering, ZIP cluster modeling, feature forecast models, composite hotness scoring, and the interactive application"
        imageWidth={1916}
        imageHeight={821}
      />
    </article>
  </Container>
</BaseLayout>

<style>
  .atlas-page {
    padding-block: 1.5rem 3rem;
  }

  .atlas-page__breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .atlas-page__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .atlas-page__breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .atlas-page__breadcrumb-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--color-accent-deep);
  }

  .atlas-page__header {
    display: grid;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1024px) {
    .atlas-page__header {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.85fr);
      align-items: center;
      gap: 2.5rem;
    }
  }

  .atlas-page__intro {
    min-width: 0;
  }

  .atlas-page__project-logo {
    display: block;
    height: clamp(2.1rem, 3.6vw, 2.75rem);
    width: auto;
    margin-bottom: 1.5rem;
  }

  .atlas-page__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--color-ink);
  }

  .atlas-page__title .font-accent {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    line-height: 1;
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: unset;
    text-rendering: optimizeSpeed;
  }

  .atlas-page__title .font-display {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    line-height: 0.95;
    font-weight: var(--text-display--font-weight);
  }

  .atlas-page__summary {
    margin: 0 0 1.25rem;
    max-width: 32rem;
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .atlas-page__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .atlas-page__stack {
    margin-bottom: 1.5rem;
  }

  .atlas-page__stack-label {
    margin: 0 0 0.6rem;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .atlas-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .atlas-page__graphic {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .atlas-page__graphic {
      justify-content: flex-end;
    }
  }

  .atlas-page__info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }

  @media (min-width: 1024px) {
    .atlas-page__info-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .atlas-info-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-ink);
    background: var(--color-surface);
    padding: 1.35rem 1.4rem;
  }

  .atlas-info-card__title {
    margin: 0 0 0.85rem;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-muted);
  }

  .atlas-info-card__subtitle {
    margin: 1.1rem 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .atlas-info-card__text {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .atlas-info-card__text--spaced {
    margin-top: 0.85rem;
  }

  .atlas-checklist {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .atlas-checklist__item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.65rem 0;
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-ink);
  }

  .atlas-checklist__item:not(:last-child) {
    border-bottom: 1px dotted var(--color-border-muted);
  }

  .atlas-checklist__item:first-child {
    padding-top: 0.15rem;
  }

  .atlas-checklist__icon {
    flex-shrink: 0;
    margin-top: 0.12rem;
    color: var(--color-status-active);
  }

  .atlas-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
  }

  .atlas-features__item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-ink);
  }

  .atlas-features__icon {
    flex-shrink: 0;
    margin-top: 0.08rem;
    color: var(--color-accent-deep);
  }
</style>
